[
  [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-i",
    "@SRC",
    "-filter_complex",
    "[0:v]scale=1080:1920:force_original_aspect_ratio=increase:flags=lanczos,crop=1080:1920,setsar=1,fps=30,format=yuv420p[v]",
    "-map",
    "[v]",
    "-c:v",
    "libx264",
    "-profile:v",
    "high",
    "-preset",
    "medium",
    "-g",
    "60",
    "-keyint_min",
    "60",
    "-sc_threshold",
    "0",
    "-bf",
    "2",
    "-flags",
    "+cgop",
    "-crf",
    "18",
    "-maxrate",
    "25000k",
    "-bufsize",
    "50000k",
    "-colorspace",
    "bt709",
    "-color_primaries",
    "bt709",
    "-color_trc",
    "bt709",
    "-movflags",
    "+faststart",
    "-map_metadata",
    "-1",
    "-shortest",
    "@OUT/src-reels.mp4"
  ],
  [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-ss",
    "0.33",
    "-i",
    "@OUT/src-reels.mp4",
    "-frames:v",
    "1",
    "-vf",
    "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920",
    "-q:v",
    "2",
    "@OUT/src-reels-thumb.jpg"
  ]
]

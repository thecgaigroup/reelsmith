[
  [
    "ffmpeg",
    "-hide_banner",
    "-nostats",
    "-i",
    "@SRC",
    "-af",
    "loudnorm=I=-14:TP=-1.5:LRA=11:print_format=json",
    "-f",
    "null",
    "-"
  ],
  [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-i",
    "@SRC",
    "-map",
    "0:a:0",
    "-vn",
    "-af",
    "loudnorm=I=-14:TP=-1.5:LRA=11:measured_I=-24.00:measured_TP=-21.00:measured_LRA=0.00:measured_thresh=-34.00:offset=0.00:linear=true,aresample=192000,alimiter=limit=-2.5dB:attack=1:release=50:level=false,aresample=48000",
    "-ac",
    "2",
    "-c:a",
    "pcm_s24le",
    "@OUT/.src-reels.pre.wav"
  ],
  [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-i",
    "@OUT/.src-reels.pre.wav",
    "-af",
    "volume=0.00dB",
    "-c:a",
    "aac",
    "-aac_coder",
    "fast",
    "-b:a",
    "128k",
    "-ar",
    "48000",
    "@OUT/.src-reels.m4a"
  ],
  [
    "ffmpeg",
    "-hide_banner",
    "-nostats",
    "-i",
    "@OUT/.src-reels.m4a",
    "-filter_complex",
    "ebur128=peak=true",
    "-f",
    "null",
    "-"
  ],
  [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-i",
    "@SRC",
    "-i",
    "@OUT/.src-reels.m4a",
    "-filter_complex",
    "[0:v]scale=1080:1920:force_original_aspect_ratio=increase:flags=lanczos,crop=1080:1920,setsar=1,fps=30,format=yuv420p[v]",
    "-map",
    "[v]",
    "-map",
    "1:a:0",
    "-c:a",
    "copy",
    "-c:v",
    "libx264",
    "-profile:v",
    "high",
    "-preset",
    "medium",
    "-g",
    "60",
    "-keyint_min",
    "60",
    "-sc_threshold",
    "0",
    "-bf",
    "2",
    "-flags",
    "+cgop",
    "-crf",
    "18",
    "-maxrate",
    "25000k",
    "-bufsize",
    "50000k",
    "-colorspace",
    "bt709",
    "-color_primaries",
    "bt709",
    "-color_trc",
    "bt709",
    "-movflags",
    "+faststart",
    "-map_metadata",
    "-1",
    "-shortest",
    "@OUT/src-reels.mp4"
  ],
  [
    "ffmpeg",
    "-y",
    "-v",
    "error",
    "-ss",
    "1.00",
    "-i",
    "@OUT/src-reels.mp4",
    "-frames:v",
    "1",
    "-vf",
    "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920",
    "-q:v",
    "2",
    "@OUT/src-reels-thumb.jpg"
  ]
]
